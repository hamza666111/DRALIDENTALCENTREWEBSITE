{
  "name": "dadc-admin",
  "main": "worker/admin.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist-admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dadc-admin",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAILS": "REPLACE_WITH_YOUR_EMAIL"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
