{
  "name": "dadc-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "sitemap": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.admin.json --noEmit",
    "admin:dev": "vite --config vite.admin.config.ts",
    "admin:build": "vite build --config vite.admin.config.ts",
    "admin:preview": "vite preview --config vite.admin.config.ts",
    "admin:types": "wrangler types worker/admin-env.d.ts --config wrangler.admin.jsonc",
    "admin:worker:dev": "wrangler dev --config wrangler.admin.jsonc",
    "admin:deploy": "npm run admin:build && wrangler deploy --config wrangler.admin.jsonc"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wrangler": "^4.151.0"
  }
}
