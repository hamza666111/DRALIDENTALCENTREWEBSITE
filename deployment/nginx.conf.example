# Include inside an HTTPS server block with your real server_name and document root.
# root /var/www/dadc/dist;
index index.html;
location / {
    try_files $uri $uri/ =404;
}
error_page 404 /404.html;
location = /404.html {
    internal;
}
location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
